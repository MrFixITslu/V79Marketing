PORT=3070
APP_URL=https://marketing.v79sl.com
NODE_ENV=production
TRUST_PROXY=1

# Required application secrets.
JWT_SECRET=
DATABASE_PATH=/app/data/v79_marketing.sqlite
# Local AI is preferred to control operating cost.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Personal bring-your-own-key (BYOK) media and cloud AI providers.
# Required before any user can save their own provider API key. Generate once
# on a trusted host with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Store securely outside Git/DB and include in encrypted off-host backups.
# If lost/rotated without re-encryption, users must reconnect their keys.
# NEVER reuse the social OAuth, JWT, audit or Hub signing secrets.
V79_MEDIA_CREDENTIALS_MASTER_KEY=
# The old shared GEMINI_API_KEY is intentionally not used for user generation.
# Cloud calls use only the logged-in user's encrypted Gemini key and explicit
# per-request opt-in. Local Ollama/templates require no media API keys.
GEMINI_MODEL=gemini-2.5-flash

# Hub-only access. Customers do not register or buy plans inside Marketing.
V79_HUB_PUBLIC_URL=https://hub.v79sl.com
V79_HUB_INTERNAL_URL=http://v79-hub:3040
V79_MARKETING_LAUNCH_SECRET=

# Signed Hub -> Marketing provisioning/team membership writes. Keep separate from summary credentials.
V79_HUB_PROVISION_SECRET=

# Read-only Hub summary contract.
V79_PLATFORM_SHARED_SECRET=

# Marketing business events -> Hub timeline.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=

# Optional comma-separated browser origins. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Legacy/demo switches: keep disabled in production.
V79_ALLOW_LEGACY_LOGIN=0
V79_MARKETING_SEED_DEMO=0
V79_ENABLE_SIMULATED_PUBLISHER=0


# Social provider OAuth. Leave a provider blank until its developer app is approved.
# Required whenever any provider below is enabled; use a unique 32+ character secret.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Meta: Facebook Pages + Instagram Business.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# LinkedIn Company Pages. 202609 is LinkedIn's current latest Marketing API version as of Oct 2026.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202609

# TikTok Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Business Profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3. Use a dedicated Google Cloud OAuth client/project so YouTube audit status is isolated.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Default 1 GiB server-side source-video ceiling. Increase only if the host/network can safely handle it.
YOUTUBE_MAX_UPLOAD_BYTES=1073741824

# Opt-in: only enable after the matching Hub signed entitlement endpoint is deployed and tested.
V79_ENTITLEMENT_RECHECK_ENABLED=0

# Private Campaign Studio review signing key (32+ random characters).
# Distinct from JWT, BYOK master key, OAuth tokens and Hub production keys.
# Required to pin and privately review media. Store in encrypted backups and
# restore the identical key; rotating it needs a deliberate re-sign migration.
# STUDIO RECEIPTS NEVER AUTHORISE PUBLIC PUBLISHING.
V79_MARKETING_STUDIO_REVIEW_KEY=
# Global release lock for the exact customer approval and dispatch worker.
# LEAVE 0 before isolated browser, provider, backup/restore and owner sign-off.
# This switch alone does not bypass the required live Hub entitlement gate.
V79_STUDIO_PUBLISH_ENABLED=0
# Legacy general publisher is held in application code for real users until
# per-user destination selection and signed publication approval are complete.
# Synthetic development-only simulation remains allowed outside production.
#
# G3: coordinated founder-only Marketing production; disabled until acceptance
V79_MARKETING_PRODUCTION_ENABLED=0
V79_MARKETING_PRODUCTION_PUBLISH_ENABLED=0
V79_MARKETING_PRODUCTION_OWNER_ORG_ID=
V79_MARKETING_PRODUCTION_SHARED_SECRET=
V79_MARKETING_PRODUCTION_AUDIT_KEY=
V79_PRODUCTION_ASSET_DIR=/app/data/production-assets

# Optional opt-in newsletter provider, restricted to this exact segment/sender
V79_NEWSLETTER_RESEND_API_KEY=
V79_NEWSLETTER_SEGMENT_ID=
V79_NEWSLETTER_FROM=
