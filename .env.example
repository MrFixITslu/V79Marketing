PORT=3070
APP_URL=https://marketing.v79sl.com
NODE_ENV=production
TRUST_PROXY=1

# Required application secrets.
JWT_SECRET=
DATABASE_PATH=/app/data/v79_marketing.sqlite
# Local AI is preferred to control operating cost.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional external fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hub-only access. Customers do not register or buy plans inside Marketing.
V79_HUB_PUBLIC_URL=https://hub.v79sl.com
V79_HUB_INTERNAL_URL=http://v79-hub:3040
V79_MARKETING_LAUNCH_SECRET=

# Signed Hub -> Marketing provisioning/team membership writes. Keep separate from summary credentials.
V79_HUB_PROVISION_SECRET=

# Read-only Hub summary contract.
V79_PLATFORM_SHARED_SECRET=

# Marketing business events -> Hub timeline.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=

# Optional comma-separated browser origins. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Legacy/demo switches: keep disabled in production.
V79_ALLOW_LEGACY_LOGIN=0
V79_MARKETING_SEED_DEMO=0
V79_ENABLE_SIMULATED_PUBLISHER=0


# Social provider OAuth. Leave a provider blank until its developer app is approved.
# Required whenever any provider below is enabled; use a unique 32+ character secret.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Meta: Facebook Pages + Instagram Business.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# LinkedIn Company Pages. 202609 is LinkedIn's current latest Marketing API version as of Oct 2026.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202609

# TikTok Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Business Profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3. Use a dedicated Google Cloud OAuth client/project so YouTube audit status is isolated.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Default 1 GiB server-side source-video ceiling. Increase only if the host/network can safely handle it.
YOUTUBE_MAX_UPLOAD_BYTES=1073741824
