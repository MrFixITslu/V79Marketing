PORT=3070
APP_URL=https://marketing.v79sl.com
NODE_ENV=production
TRUST_PROXY=1

# Required application secrets.
JWT_SECRET=
DATABASE_PATH=/app/data/v79_marketing.sqlite
GEMINI_API_KEY=

# Hub-only access. Customers do not register or buy plans inside Marketing.
V79_HUB_PUBLIC_URL=https://hub.v79sl.com
V79_HUB_INTERNAL_URL=http://v79-hub:3040
V79_MARKETING_LAUNCH_SECRET=

# Read-only Hub summary contract.
V79_PLATFORM_SHARED_SECRET=

# Marketing business events -> Hub timeline.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=

# Optional comma-separated browser origins. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Legacy/demo switches: keep disabled in production.
V79_ALLOW_LEGACY_LOGIN=0
V79_MARKETING_SEED_DEMO=0
V79_ENABLE_SIMULATED_PUBLISHER=0
