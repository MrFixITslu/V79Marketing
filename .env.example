# V79 Marketing Hub Environment Configuration
PORT=3000
NODE_ENV=production

# Security & Session Secrets
JWT_SECRET=v79-production-jwt-secret-key-change-me-in-prod-2026
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3070,https://app.v79marketing.com

# Google Gemini AI Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Database Storage Path (Defaults to ./data/v79_marketing.sqlite)
DATABASE_PATH=./data/v79_marketing.sqlite
